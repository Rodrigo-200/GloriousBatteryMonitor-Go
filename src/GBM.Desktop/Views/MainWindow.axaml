<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GBM.Desktop.ViewModels"
        xmlns:views="using:GBM.Desktop.Views"
        x:Class="GBM.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Glorious Battery Monitor"
        Width="420" Height="640"
        MinWidth="380" MinHeight="560"
        Icon="/Assets/app-icon.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <views:DashboardView DataContext="{Binding}" />
        <ContentControl IsVisible="{Binding IsSettingsOpen}"
                        Content="{Binding SettingsOverlayContent}">
            <ContentControl.DataTemplates>
                <DataTemplate x:DataType="vm:MainViewModel">
                    <views:SettingsView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

        <!-- Invisible drag region at the top for window movement -->
        <Border Name="TitleBar"
                Height="44"
                VerticalAlignment="Top"
                Background="Transparent" />
    </Panel>

</Window>
