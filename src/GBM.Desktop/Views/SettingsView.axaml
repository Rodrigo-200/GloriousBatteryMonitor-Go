<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GBM.Desktop.ViewModels"
             xmlns:converters="using:GBM.Desktop.Converters"
             x:Class="GBM.Desktop.Views.SettingsView"
             x:DataType="vm:MainViewModel"
             x:Name="RootControl">

    <UserControl.Resources>
        <converters:ThemeSelectedIndicatorTransformConverter x:Key="ThemeIndicatorTransformConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
    </UserControl.Styles>

    <!-- Full-Page Settings View -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}" RowDefinitions="Auto,*,Auto">

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Margin="32,64,32,16" ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource Settings}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="ghost"
                    Command="{Binding CloseSettingsCommand}">
                <PathIcon Width="16" Height="16"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
            </Button>
        </Grid>

        <!-- ── Scrollable Content ── -->
        <ScrollViewer Grid.Row="1" Padding="32,0,32,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Margin="0,8,0,24">

                <!-- ── GENERAL ── -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource General}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               LetterSpacing="1.5"
                               Margin="8,0,0,0" />

                    <Border x:Name="GeneralCard" Classes="settings-card">
                        <StackPanel>
                            <!-- Start with OS -->
                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource StartWithOS}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource AutoStart}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithOS}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Start Minimized -->
                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource StartMinimized}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource StartTray}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Theme -->
                            <Border Classes="setting-row">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{DynamicResource Theme}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Appearance}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Border Background="{DynamicResource WindowBackgroundBrush}"
                                            CornerRadius="8"
                                            Padding="2"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource SurfaceBorderBrush}">
                                        <Grid x:Name="ThemeTrack"
                                              Height="34"
                                              ColumnDefinitions="*,*,*"
                                              ClipToBounds="True">
                                            <Border Grid.Column="0"
                                                    Margin="1"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="6"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                    BoxShadow="0 1 4 0 #14000000">
                                                <Border.RenderTransform>
                                                    <MultiBinding Converter="{StaticResource ThemeIndicatorTransformConverter}">
                                                        <Binding Path="Bounds.Width" ElementName="ThemeTrack" />
                                                        <Binding Path="ThemeSelectedIndex" />
                                                    </MultiBinding>
                                                </Border.RenderTransform>
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.17" Easing="CubicEaseOut" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>

                                            <Button Grid.Column="0"
                                                    Classes="theme-choice"
                                                    Classes.selected="{Binding IsSystemThemeSelected}"
                                                    Command="{Binding SetThemeCommand}"
                                                    CommandParameter="system"
                                                    Content="{DynamicResource System}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ZIndex="1" />
                                            <Button Grid.Column="1"
                                                    Classes="theme-choice"
                                                    Classes.selected="{Binding IsDarkThemeSelected}"
                                                    Command="{Binding SetThemeCommand}"
                                                    CommandParameter="dark"
                                                    Content="{DynamicResource Dark}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ZIndex="1" />
                                            <Button Grid.Column="2"
                                                    Classes="theme-choice"
                                                    Classes.selected="{Binding IsLightThemeSelected}"
                                                    Command="{Binding SetThemeCommand}"
                                                    CommandParameter="light"
                                                    Content="{DynamicResource Light}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ZIndex="1" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Language}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource ChooseLanguage}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding LanguageSelectedIndex}" MinWidth="140">
                                        <ComboBoxItem Content="{DynamicResource LanguageSystem}" Tag="system" />
                                        <ComboBoxItem Content="{DynamicResource English}" />
                                        <ComboBoxItem Content="Русский" Tag="ru" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Notifications -->
                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Notifications}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource BatteryAlerts}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsEnabled}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Critical Battery Sound -->
                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Sound10}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CriticalBatterySoundName}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Choose}" Classes="surface" Click="OnChooseCriticalSoundClicked" Padding="10,6" />
                                        <Button Content="{DynamicResource None}" Classes="ghost" Click="OnClearCriticalSoundClicked" Padding="8,6" />
                                    </StackPanel>
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Content="{DynamicResource TestSound}"
                                            Classes="ghost"
                                            Command="{Binding TestCriticalBatterySoundCommand}"
                                            IsEnabled="{Binding HasCriticalBatterySound}"
                                            HorizontalAlignment="Right"
                                            Padding="8,4"
                                            Margin="0,4,0,0" />
                                </Grid>
                            </Border>

                            <!-- Debug Logging -->
                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Debug}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource DebugDescription}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding DebugLogging}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── ADVANCED ── -->
                <Border Classes="settings-card" MaxWidth="{Binding Bounds.Width, ElementName=GeneralCard}">
                    <Expander IsExpanded="{Binding IsAdvancedExpanded}" HorizontalAlignment="Stretch" Padding="8">
                        <Expander.Header>
                            <TextBlock Text="{DynamicResource Advanced}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       LetterSpacing="1.5"
                                       Margin="4,0,0,0" />
                        </Expander.Header>
                        <StackPanel Spacing="0" Margin="0,4,0,4">

                            <!-- Refresh Rate -->
                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{DynamicResource RefreshRate}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding RefreshInterval}" Minimum="1" Maximum="60" Width="110" FormatString="0" />
                                </Grid>
                            </Border>

                            <!-- Low Battery Threshold -->
                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{DynamicResource LowBattery}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding LowThreshold}" Minimum="5" Maximum="50" Width="110" FormatString="0" />
                                </Grid>
                            </Border>

                            <!-- Critical Battery Threshold -->
                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{DynamicResource CriticalBattery}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding CriticalThreshold}" Minimum="5" Maximum="30" Width="110" FormatString="0" />
                                </Grid>
                            </Border>

                            <!-- Notification Cooldown -->
                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{DynamicResource Cooldown}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding NotificationCooldownMinutes}" Minimum="1" Maximum="60" Width="110" FormatString="0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- ── DEVELOPER TOOLS ── -->
                <Border Classes="settings-card" MaxWidth="{Binding Bounds.Width, ElementName=GeneralCard}">
                    <Expander IsExpanded="{Binding IsDevToolsExpanded}" HorizontalAlignment="Stretch" Padding="8">
                        <Expander.Header>
                            <TextBlock Text="{DynamicResource Developer}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       LetterSpacing="1.5"
                                       Margin="4,0,0,0" />
                        </Expander.Header>
                        <StackPanel Spacing="16" Margin="4,8,4,8">

                            <!-- Action Grid -->
                            <UniformGrid Columns="2" Rows="2">
                                <Button Content="{DynamicResource ScanHID}" Classes="surface" Command="{Binding ScanHidDevicesCommand}" Margin="0,0,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Content="{DynamicResource Capture}" Classes="surface" Command="{Binding CaptureReportCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Content="{DynamicResource Copy}" Classes="surface" Command="{Binding CopyOutputCommand}" Margin="0,0,8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Content="{DynamicResource Diagnostics}" Classes="surface" Command="{Binding CaptureDiagnosticsCommand}" Margin="0,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </UniformGrid>

                            <!-- Embedded Terminal Block -->
                            <Border Background="#1A1C1E" CornerRadius="8" Padding="1" BorderThickness="1" BorderBrush="#333333">
                                <TextBox Text="{Binding DevOutput}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         MaxHeight="180" MinHeight="100"
                                         FontSize="11"
                                         Foreground="#00E5FF"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Code, JetBrains Mono, Consolas, monospace" />
                            </Border>

                        </StackPanel>
                    </Expander>
                </Border>

                <!-- ── UPDATES ── -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Updates}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               LetterSpacing="1.5"
                               Margin="8,0,0,0" />
                    <Border Classes="settings-card">
                        <StackPanel>
                            <Border Classes="setting-row" Background="Transparent">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Beta}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{DynamicResource BetaDescription}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableBetaUpdates}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar Value="{Binding UpdateDownloadProgress}" Maximum="100" Height="4" IsVisible="{Binding IsDownloadingUpdate}" Foreground="{DynamicResource AccentCyanBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="surface" Content="{DynamicResource CheckUpdates}" Command="{Binding CheckForUpdateCommand}" IsEnabled="{Binding !IsCheckingUpdate}" />
                                        <Button Classes="accent" Content="{Binding UpdateActionButtonText}" Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding IsUpdateAvailable}" IsEnabled="{Binding !IsDownloadingUpdate}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer Actions ── -->
        <Border Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SurfaceBorderBrush}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="32,16,32,24" Spacing="12">
                <Button Content="{DynamicResource Cancel}" Classes="muted"
                        Command="{Binding CloseSettingsCommand}" />
                <Button Content="{DynamicResource Save}" Classes="accent"
                        Command="{Binding SaveSettingsCommand}" />
            </StackPanel>
        </Border>

    </Grid>

</UserControl>
