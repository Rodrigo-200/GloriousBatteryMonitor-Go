<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GBM.Desktop.ViewModels"
             xmlns:controls="using:GBM.Desktop.Controls"
             x:Class="GBM.Desktop.Views.DashboardView"
             x:DataType="vm:MainViewModel">

    <Panel Background="{DynamicResource WindowBackgroundBrush}">
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
              Margin="28,44,28,24">

            <!-- ── Row 0: Header (settings gear) ── -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Top">
                <Border Grid.Column="0" IsVisible="False" /> <!-- Placeholder to maintain grid column structure -->                <Button Grid.Column="2"
                        Classes="ghost"
                        HorizontalAlignment="Right"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings">
                    <PathIcon Width="18" Height="18"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1Z" />
                </Button>
            </Grid>

            <!-- ── Row 1: Hero Battery Arc Gauge ── -->
            <controls:BatteryGauge Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Width="270"
                                   Level="{Binding BatteryLevel}"
                                   IsCharging="{Binding IsCharging}"
                                   IsConnected="{Binding IsConnected}" />

            <!-- ── Row 2: Device Name + Connection Status ── -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Margin="0,4,0,24">

                <TextBlock Text="{Binding DeviceName}"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />

                <controls:StatusBadge HorizontalAlignment="Center"
                                      Connection="{Binding ConnectionState}"
                                      IsCharging="{Binding IsCharging}" />
            </StackPanel>

            <!-- ── Row 3: Stat Cards (2-up) ── -->
            <Grid Grid.Row="3"
                  ColumnDefinitions="*,12,*"
                  Margin="0,0,0,12">

                <!-- Time Remaining -->
                <Border Grid.Column="0"
                        Classes="stat-card"
                        Padding="18,16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding EstimateLabel}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   LetterSpacing="0.5" />
                        <TextBlock Text="{Binding TimeRemainingText}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Charged To -->
                <Border Grid.Column="2"
                        Classes="stat-card"
                        Padding="18,16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CHARGED TO"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   LetterSpacing="0.5" />
                        <TextBlock Text="{Binding ChargedToText}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Row 4: Charge details (full width) ── -->
            <Border Grid.Row="4"
                    Classes="stat-card"
                    Padding="18,14"
                    Margin="0,0,0,12">
                <Grid RowDefinitions="Auto,12,Auto,12,Auto">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="FULL CHARGE LASTS"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   LetterSpacing="0.5"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FullChargeDurationText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                        <TextBlock Text="LAST CHARGE"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   LetterSpacing="0.5"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastChargedText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="4" ColumnDefinitions="Auto,*">
                        <TextBlock Text="LAST SYNC"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   LetterSpacing="0.5"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastSyncText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <!-- ── FLOATING OVERLAYS ── -->

        <!-- 1) Floating Update Pill (Top Center, shifted down into the arc's empty space to avoid window controls) -->
        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,52,0,0"
                IsVisible="{Binding ShowUpdateIndicator}"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0"
                CornerRadius="24"
                BoxShadow="0 4 16 0 #1A000000"
                Padding="6,4,6,4">
            <Border.Transitions>
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.3" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="4">

                <Grid Margin="6,0,6,0" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding !IsDownloadingUpdate}">
                   <Ellipse Fill="{DynamicResource AccentCyanBrush}" Opacity="0.2" />
                   <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Binding UpdateIndicatorText}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="2,0,8,0"/>

                <ProgressBar IsVisible="{Binding IsDownloadingUpdate}"
                             Value="{Binding UpdateDownloadProgress}"
                             Minimum="0" Maximum="100"
                             Height="4" CornerRadius="2"
                             Width="50"
                             Foreground="{DynamicResource AccentCyanBrush}"
                             Background="{DynamicResource SurfaceBorderBrush}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             ShowProgressText="False"/>

                <Button Command="{Binding UpdateIndicatorActionCommand}"
                        Content="{Binding UpdateIndicatorActionText}"
                        IsVisible="{Binding ShowUpdateIndicatorAction}"
                        Classes="ghost"
                        Foreground="{DynamicResource AccentCyanBrush}"
                        FontSize="11"
                        FontWeight="Bold"
                        Padding="14,6"
                        CornerRadius="16"
                        MinHeight="0"
                        VerticalAlignment="Center"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- 2) Floating Beautiful Toast (Bottom Center) -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,32"
                IsVisible="{Binding IsToastVisible}"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0"
                CornerRadius="16"
                BoxShadow="0 8 24 0 #2A000000"
                Padding="16,10">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                          Width="13" Height="13"
                          Foreground="{DynamicResource AccentCyanBrush}" />
                <TextBlock Text="{Binding ToastMessage}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

    </Panel>

</UserControl>
